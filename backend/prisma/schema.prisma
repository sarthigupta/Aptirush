// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"

}

datasource db {
  provider = "postgresql"
}


enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum DocumentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum BattleStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  MCQ
  TITA
}

enum QuestionStatus {
  PUBLISHED
  NEEDS_REVIEW
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  role          Role      @default(STUDENT)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  testAttempts  TestAttempt[]
  facultyId     String?
  faculty       User?        @relation("StudentFaculty", fields: [facultyId], references: [id])
  students      User[]       @relation("StudentFaculty")
  createdTests  CustomTest[]
  battlesAsP1   Battle[] @relation("BattlePlayer1")
  battlesAsP2   Battle[] @relation("BattlePlayer2")
  battlesWon    Battle[] @relation("BattleWinner")
  elo           Int      @default(1000)
}
model DocumentJob {
  id         String         @id @default(uuid())
  filename   String
  status     DocumentStatus @default(PENDING)
  questions  Question[] 
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt  
}

model Module {
  id            String     @id @default(uuid())
  chapterNumber Int?
  title         String     
  questions     Question[]
  testAttempts  TestAttempt[]
}

model Question {
  id            String         @id @default(uuid())
  moduleId      String
  module        Module         @relation(fields: [moduleId], references: [id])
  questionText  String
  options       Json     
  correctAnswer String   
  type          QuestionType
  status        QuestionStatus @default(NEEDS_REVIEW)
  documentJobId String?
  documentJob   DocumentJob?   @relation(fields: [documentJobId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customTests   CustomTest[]
  battles       Battle[]
}

model TestAttempt {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  moduleId     String?
  module       Module?     @relation(fields: [moduleId], references: [id])
  customTestId String?
  customTest   CustomTest? @relation(fields: [customTestId], references: [id])
  score        Int
  total        Int
  durationMs   Int         @default(0)
  createdAt    DateTime    @default(now())
}

model CustomTest {
  id          String         @id @default(uuid())
  title       String
  facultyId   String
  faculty     User           @relation(fields: [facultyId], references: [id])
  questions   Question[]
  attempts    TestAttempt[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Battle {
  id          String       @id @default(uuid())
  player1Id   String
  player2Id   String?
  player1     User         @relation("BattlePlayer1", fields: [player1Id], references: [id])
  player2     User?        @relation("BattlePlayer2", fields: [player2Id], references: [id])
  winnerId    String?
  winner      User?        @relation("BattleWinner", fields: [winnerId], references: [id])
  status      BattleStatus @default(WAITING)
  questions   Question[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
